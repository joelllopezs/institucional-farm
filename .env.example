# Copie para .env e preencha. Tudo é opcional; o que ficar vazio simplesmente não aparece no site.

# WhatsApp com DDI + DDD + número, só dígitos (ex.: 5500900000000)
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_MESSAGE=Olá! Gostaria de falar com um especialista da Fazenda Horizonte Agro.

# Contatos exibidos no site
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# Endpoint que recebe o formulário via POST JSON (Formspree, Getform, API própria etc.)
VITE_FORM_ENDPOINT=
